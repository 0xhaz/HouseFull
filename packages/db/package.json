{
  "name": "@housefull/db",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "import:boundaries": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local scripts/import-boundaries.ts",
    "import:nyc": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local scripts/import-nyc.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "fflate": "0.8.3"
  }
}
