# Copy to .env.local and fill in. Never commit real values.

# Qloo (server only)
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_DAILY_BUDGET=1500
QLOO_PER_IP_DAILY=300
QLOO_RECORD_FIXTURES=true  # save live responses to the private fixtures table for demo mode

# Google Cloud / Vertex AI
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global   # newer Gemini models are only on the global endpoint (us-east4 has 2.5 only, Oct 2026)
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Database + cache
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54522/postgres   # local Supabase (pnpm db:start)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Other APIs
TICKETMASTER_API_KEY=
MTA_API_KEY=
NYC_GEOCLIENT_KEY=
SOCRATA_APP_TOKEN=
MAPBOX_TOKEN=

# App
PORT=4100
API_PUBLIC_URL=http://localhost:4100
WEB_PUBLIC_URL=http://localhost:3100   # also the Clerk authorized party (comma-separate several)

# Clerk (auth + organizations = workspaces). The web app reads the same keys from apps/web/.env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ENCRYPTION_KEY=             # for webhook URLs and queued sign-ups
CLICK_SALT=                 # HMAC salt for tracking-link click dedupe (no IPs stored)
DEMO_MODE=false             # true = serve fixtures only (also automatic when QLOO_API_KEY is empty)
RUNS_PER_HOUR=20            # per-IP limit on POST /runs
PRESET_REUSE_HOURS=720      # presets reuse a finished run this recent (instant demo, 30 days); 0 = always fresh
LOG_LEVEL=info

# Web (public, safe to expose)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100
